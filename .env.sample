NODE_ENV = development
# NODE_ENV = production
PORT = 4000
# MONGODB_URI = mongodb+srv://username:password@cluster2.lbksl3m.mongodb.net (cloud)
MONGODB_URI = mongodb://0.0.0.0:27017 (local)

SELF_PING_ENABLED=true
SELF_PING_INTERVAL_MS=900000 # 15 minutes
